{
  "manifest_version": 3,
  "name": "校园 AI 本地助手",
  "version": "0.6.2",
  "description": "让校园 AI 自动使用本机文件与 PowerShell。",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://ai.cuhk.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://ai.cuhk.edu.cn/chat/*"],
      "js": ["bridge-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://ai.cuhk.edu.cn/chat/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "key": ""
}
